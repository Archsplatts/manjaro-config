#!/bin/bash

selection=$(echo -e " Installer les mises à jour\n󱘊 Lire les notes de mise à jour Manjaro\n󰮯 Nettoyer le cache de pacman\n Gérer les paquets orphelins\n󰁯 Sauvegarde Timeshift" | rofi -dmenu -config $HOME/.config/rofi/system-menu.rasi)

if [[ -n "$selection" ]]; then
    case "$selection" in
        " Installer les mises à jour")
			alacritty -e sh -c "sudo pacman-mirrors -c France,Germany && sudo pacman -Syyu || true; echo; read -n 1 -s -p 'Appuyez sur une touche pour quitter...'"
			;;
	    "󱘊 Lire les notes de mise à jour Manjaro")
	   		firefox "https://forum.manjaro.org/c/announcements/stable-updates/12"
	   		;;		
        "󰮯 Nettoyer le cache de pacman")
            alacritty -e sh -c "sudo pacman -Sc || true; echo; read -n 1 -s -p 'Appuyez sur une touche pour quitter...'"
            ;;
        " Gérer les paquets orphelins")
            alacritty -e sh -c '
                orphans=$(pacman -Qdtq 2>/dev/null)
                if [[ -z "$orphans" ]]; then
                    echo "Aucun paquet orphelin trouvé."
                else
                    echo "Paquets orphelins trouvés :"
                    echo "$orphans"
                    echo ""
                    read -p "Voulez-vous les supprimer ? (o/N) : " confirm
                    if [[ "$confirm" =~ ^[Oo]$ ]]; then
                        echo "$orphans" | sudo pacman -Rs --noconfirm -
                        echo "Nettoyage terminé."
                    else
                        echo "Opération annulée."
                    fi
                fi
                echo ""
                read -n 1 -s -p "Appuyez sur une touche pour quitter..."
            '
            ;;
        "󰁯 Sauvegarde Timeshift")
			alacritty -e sh -c "sudo timeshift --create || true; echo; read -n 1 -s -p 'Appuyez sur une touche pour quitter...'"
			;;
    esac
fi   
